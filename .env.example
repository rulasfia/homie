# Copy this file to `.env` and fill in your values.
# Loaded automatically by the dev / start scripts (node --env-file-if-exists).

# Port for the homie server (default: 3000)
# PORT=3000

# Path to the YAML config file (default: ./homie.config.yaml)
# HOMIE_CONFIG=homie.config.yaml

# --- Beszel hub (optional — enables the "Machines" section) ---
# Create a dedicated, non-admin user in your Beszel hub for this dashboard.
BESZEL_URL=https://beszel.example.com
BESZEL_EMAIL=homie@example.com
BESZEL_PASSWORD=change-me

# Last resort if your Beszel hub uses a self-signed certificate
# (prefer a valid certificate or your own CA instead).
# NODE_TLS_REJECT_UNAUTHORIZED=0

# --- Docker (optional — enables the "Containers" section) ---
# Use a local socket (default /var/run/docker.sock) when running on a host
# or inside a container with the socket mounted read-only:
#   -v /var/run/docker.sock:/var/run/docker.sock:ro
# DOCKER_SOCKET=/var/run/docker.sock

# Or point to a remote/sidecar Engine API endpoint (e.g. docker-socket-proxy):
# DOCKER_HOST=tcp://docker-socket-proxy:2375
