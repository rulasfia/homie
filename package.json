{
  "name": "homie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vp dev --host\" \"node --env-file-if-exists=.env --watch server/index.ts\"",
    "dev:web": "vp dev --host",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "check": "vp check",
    "test": "vp test",
    "generate-icons": "node --experimental-strip-types scripts/generate-icons.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.16.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
