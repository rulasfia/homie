{
  "name": "homie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vp dev --host\" \"node --env-file-if-exists=.env --watch server/index.ts\"",
    "dev:web": "vp dev --host",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.16.0",
      "onFail": "download"
    }
  }
}
